/*
 * Error code list
 *
 * Guidelines:
 * - Keep generic utility and validation errors reusable.
 * - Let callers provide context-specific messages.
 *   Example:
 *     code    = ERROR_FILENAME_INVALID
 *     message = "Profile image filename is invalid"
 *
 * Number ranges:
 *   0000-0999  Common / general
 *   1000-1099  Configuration / input
 *   1100-1199  Local filesystem
 *   1200-1299  Generic path / file / validation
 *   2000-2099  MQTT
 *   3000-3099  SSH connection / auth
 *   3100-3199  SSH command execution
 *   3200-3299  SCP transfer
 *   4000-4099  Profile validation / lookup / download
 *   4100-4199  Profile upload
 *   4200-4299  Profile apply
 *   4300-4399  Remote filesystem
 *   4400-4499  SFX
 *   5000-5099  State
 */

/* =========================================================================
 * Common / general
 * ========================================================================= */
X(0,    ERROR_NONE, "No error")

/* =========================================================================
 * Configuration / input
 * ========================================================================= */
X(1001, ERROR_CONFIG_MISSING, "Configuration file not found")
X(1002, ERROR_CONFIG_INVALID, "Configuration is invalid")
X(1003, ERROR_INVALID_PARAMETERS, "Invalid parameters")

/* =========================================================================
 * Local filesystem
 * These are actual local file/directory operation failures.
 * Use validation errors below for reusable path/file checks.
 * ========================================================================= */
X(1100, ERROR_LOCAL_PATH_INVALID, "Local path is invalid")
X(1101, ERROR_LOCAL_PATH_TOO_LONG, "Local path exceeds maximum length")
X(1102, ERROR_LOCAL_DIRECTORY_CREATE_FAILED, "Failed to create local directory")
X(1103, ERROR_LOCAL_DIRECTORY_NOT_FOUND, "Local directory not found")
X(1104, ERROR_LOCAL_DIRECTORY_PERMISSION_DENIED, "Permission denied for local directory")
X(1105, ERROR_LOCAL_FILE_CREATE_FAILED, "Failed to create local file")
X(1106, ERROR_LOCAL_FILE_DELETE_FAILED, "Failed to delete local file")
X(1107, ERROR_LOCAL_FILE_READ_FAILED, "Failed to read local file")
X(1108, ERROR_LOCAL_FILE_WRITE_FAILED, "Failed to write local file")
X(1109, ERROR_LOCAL_TEMP_DIR_CREATE_FAILED, "Failed to create temporary directory")
X(1110, ERROR_LOCAL_TEMP_DIR_CLEANUP_FAILED, "Failed to clean up temporary directory")
X(1111, ERROR_LOCAL_DISK_FULL, "Local disk is full")

/* =========================================================================
 * Generic path / file / validation
 * Reusable validation codes for utility functions.
 * Callers should replace the message with context-specific text.
 * Examples:
 *   ERROR_FILENAME_INVALID -> "Profile image filename is invalid"
 *   ERROR_FILE_EXTENSION_INVALID -> "SFX file extension is invalid"
 * ========================================================================= */
X(1200, ERROR_VALIDATION_FAILED, "Validation failed")
X(1201, ERROR_PATH_INVALID, "Path is invalid")
X(1202, ERROR_FILENAME_INVALID, "Filename is invalid")
X(1203, ERROR_FILE_EXTENSION_INVALID, "File extension is invalid")
X(1204, ERROR_FILE_TYPE_INVALID, "File type is invalid")
X(1205, ERROR_FILE_NOT_FOUND, "File not found")
X(1206, ERROR_DIRECTORY_NOT_FOUND, "Directory not found")
X(1207, ERROR_REQUIRED_FILE_MISSING, "Required file is missing")
X(1208, ERROR_REQUIRED_DIRECTORY_MISSING, "Required directory is missing")
X(1209, ERROR_FILE_TOO_LARGE, "File exceeds maximum allowed size")
X(1210, ERROR_PATH_TOO_LONG, "Path exceeds maximum length")

/* =========================================================================
 * MQTT
 * ========================================================================= */
X(2001, ERROR_MQTT_CONNECTION_FAILED, "MQTT connection failed")

/* =========================================================================
 * SSH connection / authentication
 * ========================================================================= */
X(3001, ERROR_SSH_CONNECTION_FAILED, "SSH connection failed")
X(3002, ERROR_SSH_AUTH_FAILED, "SSH authentication failed")

/* =========================================================================
 * SSH command execution
 * ========================================================================= */
X(3100, ERROR_SSH_COMMAND_FAILED, "Remote SSH command failed")
X(3101, ERROR_SSH_COMMAND_TIMEOUT, "Remote SSH command timed out")
X(3102, ERROR_SSH_COMMAND_PERMISSION_DENIED, "Permission denied while executing SSH command")
X(3103, ERROR_SSH_COMMAND_NOT_FOUND, "Remote command not found")
X(3104, ERROR_SSH_COMMAND_INVALID_RESPONSE, "Unexpected response from remote command")

/* =========================================================================
 * SCP transfer
 * ========================================================================= */
X(3200, ERROR_SCP_TRANSFER_FAILED, "SCP file transfer failed")
X(3201, ERROR_SCP_TRANSFER_TIMEOUT, "SCP file transfer timed out")
X(3202, ERROR_SCP_PERMISSION_DENIED, "Permission denied during SCP transfer")
X(3203, ERROR_SCP_VERIFY_FAILED, "SCP transfer verification failed")
X(3204, ERROR_SCP_REMOTE_DISK_FULL, "Remote disk is full during SCP transfer")

/* =========================================================================
 * Profile validation / lookup / download
 * Keep these focused on profile-level workflow failures.
 * Use generic 1200-series codes for specific file validation reasons.
 * ========================================================================= */
X(4001, ERROR_PROFILE_NOT_FOUND, "Profile folder not found")
X(4002, ERROR_PROFILE_INVALID, "Profile is invalid")
X(4003, ERROR_PROFILE_DOWNLOAD_FAILED, "Profile download failed")

/* =========================================================================
 * Profile upload
 * ========================================================================= */
X(4100, ERROR_PROFILE_UPLOAD_FAILED, "Profile upload failed")
X(4101, ERROR_PROFILE_UPLOAD_CONNECT_FAILED, "Failed to connect for profile upload")
X(4102, ERROR_PROFILE_UPLOAD_PERMISSION_DENIED, "Permission denied during profile upload")
X(4103, ERROR_PROFILE_UPLOAD_TRANSFER_FAILED, "File transfer failed during profile upload")
X(4104, ERROR_PROFILE_UPLOAD_VERIFY_FAILED, "Uploaded profile verification failed")
X(4105, ERROR_PROFILE_UPLOAD_TIMEOUT, "Profile upload timed out")

/* =========================================================================
 * Profile apply
 * ========================================================================= */
X(4200, ERROR_PROFILE_APPLY_FAILED, "Failed to apply profile")
X(4201, ERROR_PROFILE_APPLY_COMMAND_FAILED, "Profile apply command failed")
X(4202, ERROR_PROFILE_APPLY_TIMEOUT, "Timed out while applying profile")
X(4203, ERROR_PROFILE_APPLY_INVALID_STATE, "Doorbell reported invalid state during apply")
X(4204, ERROR_PROFILE_APPLY_VERIFY_FAILED, "Profile apply verification failed")
X(4205, ERROR_PROFILE_APPLY_PERMISSION_DENIED, "Permission denied while applying profile")
X(4206, ERROR_PROFILE_APPLY_FILE_OPERATION_FAILED, "File operation failed while applying profile")
X(4212, ERROR_PROFILE_APPLY_RESTART_FAILED, "Failed to restart services after applying profile")
X(4213, ERROR_PROFILE_APPLY_MISSING_TMP_FILES, "Temporary uploaded files missing during apply")

/* =========================================================================
 * Remote filesystem
 * ========================================================================= */
X(4300, ERROR_REMOTE_PATH_INVALID, "Remote path is invalid or missing")
X(4301, ERROR_REMOTE_DISK_FULL, "Remote device is out of storage space")

/* =========================================================================
 * SFX
 * Keep these at the operation/preset level.
 * Use generic 1200-series validation codes for filename/extension/type issues.
 * ========================================================================= */
X(4400, ERROR_SFX_FAILED, "SFX operation failed")
X(4401, ERROR_SFX_PRESET_NOT_FOUND, "SFX preset not found")
X(4402, ERROR_SFX_VOLUME_INVALID, "SFX volume is invalid")
X(4403, ERROR_SFX_UPLOAD_FAILED, "SFX upload failed")
X(4404, ERROR_SFX_PLAY_COMMAND_FAILED, "SFX play command failed")

/* =========================================================================
 * State
 * ========================================================================= */
X(5000, ERROR_STATE_FAILED, "State operation failed")
X(5001, ERROR_STATE_SAVE_FAILED, "Failed to save state file")
X(5002, ERROR_STATE_LOAD_FAILED, "Failed to load state file")
X(5003, ERROR_STATE_FILE_NOT_FOUND, "State file not found")
X(5004, ERROR_STATE_FILE_INVALID, "State file is invalid")
X(5005, ERROR_STATE_FILE_READ_FAILED, "Failed to read state file")
X(5006, ERROR_STATE_FILE_WRITE_FAILED, "Failed to write state file")
X(5007, ERROR_STATE_PARSE_FAILED, "Failed to parse state JSON")
X(5008, ERROR_STATE_HASH_FAILED, "Failed to compute state hash")
X(5009, ERROR_STATE_COMPARE_FAILED, "State comparison failed")
X(5010, ERROR_STATE_VALIDATION_UNAVAILABLE, "State validation unavailable")
X(5011, ERROR_STATE_HASH_MISSING, "State hash missing for comparison")